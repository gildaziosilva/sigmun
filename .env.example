# SIGMUN Environment Configuration
# Copy this file to .env and adjust values as needed

# Application
APP_NAME=SIGMUN
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sigmun
DB_USER=sigmun
DB_PASSWORD=sigmun
DB_SCHEMA=sigmun

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Security
# OBRIGATÓRIA: sem SECRET_KEY válida o app recusa o startup (T-0.3).
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7
# Transição legada encerrada (T-0.2): False => X-Usuario-Id/Papel NÃO autenticam.
ALLOW_LEGACY_HEADERS=false

# CORS — origens explícitas (T-0.3). NUNCA '*' em produção com credenciais.
ALLOWED_HOSTS=[]

# Rate limiting e payload (T-0.4)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
MAX_REQUEST_BODY_BYTES=2097152

# External APIs
GOVR_BR_CLIENT_ID=
GOVR_BR_CLIENT_SECRET=
GOVR_BR_REDIRECT_URI=

# Storage local de anexos do DOM-GDO (Fase VII — expurgo assíncrono)
STORAGE_ROOT=storage/documentos

# Celery / mensageria (Fase VII — Celery & Redis)
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_RESULT_EXPIRES=3600
OUTBOX_DISPATCH_BATCH=100
OUTBOX_MAX_TENTATIVAS=5

# AWS (for production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=sigmun-documentos

# Logging
LOG_LEVEL=INFO
