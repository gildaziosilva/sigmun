# SIGMUN Environment Configuration
# Copy this file to .env and adjust values as needed

# Application
APP_NAME=SIGMUN
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sigmun
DB_USER=sigmun
DB_PASSWORD=sigmun
DB_SCHEMA=sigmun

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Security
SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# External APIs
GOVR_BR_CLIENT_ID=
GOVR_BR_CLIENT_SECRET=
GOVR_BR_REDIRECT_URI=

# Storage local de anexos do DOM-GDO (Fase VII — expurgo assíncrono)
STORAGE_ROOT=storage/documentos

# Celery / mensageria (Fase VII — Celery & Redis)
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_RESULT_EXPIRES=3600
OUTBOX_DISPATCH_BATCH=100
OUTBOX_MAX_TENTATIVAS=5

# AWS (for production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=sigmun-documentos

# Logging
LOG_LEVEL=INFO
