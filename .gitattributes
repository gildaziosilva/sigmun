# Normalização de fim de linha — SIGMUN
# Regra corporativa: LF em todo texto versionado (Linux/Python).
* text=auto eol=lf
*.py text eol=lf
*.pyi text eol=lf
*.md text eol=lf
*.rst text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
*.mako text eol=lf
# Binários — sem conversão
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.sqlite3 binary
*.db binary
