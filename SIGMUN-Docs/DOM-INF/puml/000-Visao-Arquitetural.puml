}

package "Domínios Correlatos" {
  component "DOM-SEG\nSegurança da Informação" as DSEG
  component "DOM-DAD\nDados Corporativos" as DDAD
  component "DOM-INT\nIntegração e Interoperabilidade" as DINT
}

package "Serviços Transversais" {
  component "DOM-IDN\nIdentidade e Acesso" as IDN
  component "DOM-GDO\nGestão Documental" as GDO
  component "DOM-MET\nMetadados" as MET
  component "Auditoria" as AUD
}

database "PostgreSQL\nschema inf" as DB

User --> Portal : executa rotina
Portal --> API : operações do domínio

API --> UC0 : previsto
API --> UC1 : previsto
API --> UC2 : previsto
API --> UC3 : previsto
API --> UC4 : previsto
API --> UC5 : previsto

