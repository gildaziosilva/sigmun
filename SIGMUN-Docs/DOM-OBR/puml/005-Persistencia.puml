@startuml
title DOM-OBR — Persistência

legend
SIGMUN
DOM-OBR — Obras e Infraestrutura
Persistência — Tabelas e colunas
Classificação da Informação: Pública
Responsável: Equipe SIGMUN
Status da revisão: Vigente
endlegend

hide methods
hide stereotypes
skinparam classAttributeIconSize 0

package "PostgreSQL — schema obr" {

  entity "despesas_obras" as Tdespesas_obras {
    id : UUID <<PK>>
    obra_id : TEXT <<NN>>
    medicao_id : TEXT
    descricao : TEXT <<NN>>
    tipo : TEXT <<NN>>
    valor : FLOAT <<NN>>
    data : DATE <<NN>>
    documento : TEXT
    credor : TEXT
    observacao : TEXT
    created_at : DATETIME <<NN>>
    created_by : TEXT
    is_deleted : BOOLEAN <<NN>>
  }

  entity "etapas_obras" as Tetapas_obras {
    id : UUID <<PK>>
    obra_id : TEXT <<NN>>
    numero : TEXT <<NN>>
    descricao : TEXT <<NN>>
    tipo : TEXT <<NN>>
    situacao : TEXT <<NN>>
    percentual_previsto : FLOAT <<NN>>
    percentual_realizado : FLOAT <<NN>>
    data_inicio_prevista : DATE
    data_fim_prevista : DATE
    data_conclusao : DATE
    responsavel : TEXT <<NN>>
    created_at : DATETIME <<NN>>
    updated_at : DATETIME
    created_by : TEXT
    is_deleted : BOOLEAN <<NN>>
  }

  entity "medicoes_obras" as Tmedicoes_obras {
    id : UUID <<PK>>
    obra_id : TEXT <<NN>>
    numero : TEXT <<NN>>
    tipo : TEXT <<NN>>
    situacao : TEXT <<NN>>
    data : DATE <<NN>>
    percentual_fisico : FLOAT <<NN>>
