    data_inicio_prevista : DATE
    data_fim_prevista : DATE
    data_inicio_real : DATE
    data_fim_real : DATE
    observacao : TEXT
    created_at : DATETIME <<NN>>
    updated_at : DATETIME
    created_by : TEXT
    is_deleted : BOOLEAN <<NN>>
  }

  entity "vistorias_obras" as Tvistorias_obras {
    id : UUID <<PK>>
    obra_id : TEXT <<NN>>
    data : DATE <<NN>>
    tipo : TEXT <<NN>>
    parecer : TEXT <<NN>>
    percentual_fisico_verificado : FLOAT <<NN>>
    fiscal : TEXT <<NN>>
    observacao : TEXT
    created_at : DATETIME <<NN>>
    created_by : TEXT
    is_deleted : BOOLEAN <<NN>>
  }

}

