    observacao : TEXT
    created_at : DATETIME <<NN>>
    updated_at : DATETIME
    created_by : TEXT
    is_deleted : BOOLEAN <<NN>>
  }

  entity "obras" as Tobras {
    id : UUID <<PK>>
    numero : TEXT <<UQ, NN>>
    nome : TEXT <<NN>>
    descricao : TEXT
    tipo : TEXT <<NN>>
    situacao : TEXT <<NN>>
    tipo_contratacao : TEXT <<NN>>
    fonte_recurso : TEXT <<NN>>
    valor_orcado : FLOAT <<NN>>
    valor_contratado : FLOAT <<NN>>
    valor_mediado : FLOAT <<NN>>
    valor_pago : FLOAT <<NN>>
    percentual_fisico : FLOAT <<NN>>
    percentual_financeiro : FLOAT <<NN>>
    empresa_contratada : TEXT
    numero_contrato : TEXT
    responsavel_tecnico : TEXT
    endereco : TEXT
