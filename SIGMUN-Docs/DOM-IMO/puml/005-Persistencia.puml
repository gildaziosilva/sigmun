@startuml
title DOM-IMO — Persistência

legend
SIGMUN
DOM-IMO — Cadastro Imobiliário
Persistência — Tabelas e colunas
Classificação da Informação: Pública
Responsável: Equipe SIGMUN
Status da revisão: Vigente
endlegend

hide methods
hide stereotypes
skinparam classAttributeIconSize 0

package "PostgreSQL — schema imo" {

  entity "avaliacoes_imoveis" as Tavaliacoes_imoveis {
    id : UUID <<PK>>
    imovel_id : TEXT <<NN>>
    ano : INTEGER <<NN>>
    valor_terreno_m2_unitario : FLOAT <<NN>>
    valor_construcao_m2_unitario : FLOAT <<NN>>
    aliquota_percent : FLOAT <<NN>>
    area_terreno_m2 : FLOAT <<NN>>
    area_construida_m2 : FLOAT <<NN>>
    situacao : TEXT <<NN>>
    data_avaliacao : DATE <<NN>>
    created_at : DATETIME <<NN>>
    updated_at : DATETIME
    created_by : TEXT
    is_deleted : BOOLEAN <<NN>>
  }

  entity "caracteristicas_imoveis" as Tcaracteristicas_imoveis {
    id : UUID <<PK>>
    imovel_id : TEXT <<NN>>
    obra : TEXT <<NN>>
    numero_pavimentos : INTEGER <<NN>>
    ano_renovacao : INTEGER
    observacao : TEXT
    created_at : DATETIME <<NN>>
    updated_at : DATETIME
    created_by : TEXT
  }

  entity "geometrias_imoveis" as Tgeometrias_imoveis {
    id : UUID <<PK>>
    imovel_id : TEXT <<NN>>
    geometria : TEXT <<NN>>
    latitude : FLOAT <<NN>>
    longitude : FLOAT <<NN>>
    vertices : JSON
    datum : TEXT <<NN>>
    precisao_m : FLOAT <<NN>>
    data_levantamento : DATE <<NN>>
    created_at : DATETIME <<NN>>
    updated_at : DATETIME
    created_by : TEXT
    is_deleted : BOOLEAN <<NN>>
  }

  entity "imoveis" as Timoveis {
    id : UUID <<PK>>
    inscricao_imobiliaria : TEXT <<UQ, NN>>
    logradouro_id : TEXT <<NN>>
    bairro_id : TEXT <<NN>>
    numero : TEXT
    complemento : TEXT
    tipo : TEXT <<NN>>
    situacao : TEXT <<NN>>
    tipo_propriedade : TEXT <<NN>>
    area_terreno_m2 : FLOAT <<NN>>
    area_construida_m2 : FLOAT <<NN>>
    ano_construcao : INTEGER
    created_at : DATETIME <<NN>>
    updated_at : DATETIME
    created_by : TEXT
    is_deleted : BOOLEAN <<NN>>
  }

  entity "proprietarios_imoveis" as Tproprietarios_imoveis {
    id : UUID <<PK>>
    imovel_id : TEXT <<NN>>
    pessoa_id : TEXT
    nome : TEXT <<NN>>
    cpf : TEXT <<NN>>
    vinculo : TEXT <<NN>>
    principal : BOOLEAN <<NN>>
    created_at : DATETIME <<NN>>
    updated_at : DATETIME
    created_by : TEXT
    is_deleted : BOOLEAN <<NN>>
  }

}

