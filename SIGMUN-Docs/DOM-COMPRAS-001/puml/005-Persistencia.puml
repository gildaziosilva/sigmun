package "PostgreSQL — schema compras" {

  entity "unidades_administrativas" as Tunidades_administrativas {
    id : UUID <<PK>>
    unidade_pai_id : UUID
    codigo_ibge : TEXT
    codigo_siafi : TEXT
    nome : TEXT <<NN>>
    sigla : TEXT
  }

  entity "processos_documentais" as Tprocessos_documentais {
    id : UUID <<PK>>
    unidade_id : UUID <<NN>>
    numero : TEXT <<NN>>
    ano : INTEGER <<NN>>
    assunto : TEXT <<NN>>
    descricao : TEXT
    created_at : TIMESTAMPTZ <<NN>>
    created_by : UUID
    updated_at : TIMESTAMPTZ <<NN>>
    updated_by : UUID
    deleted_at : TIMESTAMPTZ
    deleted_by : UUID
  }

  entity "fornecedores" as Tfornecedores {
    id : UUID <<PK>>
    pessoa_juridica_id : UUID <<UQ, NN>>
    situacao_cadastro : TEXT <<NN>>
    macro_categoria : TEXT
    created_at : TIMESTAMPTZ <<NN>>
    created_by : UUID
    updated_at : TIMESTAMPTZ <<NN>>
    updated_by : UUID
    deleted_at : TIMESTAMPTZ
    deleted_by : UUID
  }

  entity "itens_compras" as Titens_compras {
    id : UUID <<PK>>
    compra_id : UUID <<NN>>
    descricao : TEXT <<NN>>
    quantidade : NUMERIC <<NN>>
    valor_unitario : NUMERIC <<NN>>
    valor_total : NUMERIC <<NN>>
    created_at : TIMESTAMPTZ <<NN>>
    created_by : UUID
    updated_at : TIMESTAMPTZ <<NN>>
    updated_by : UUID
    deleted_at : TIMESTAMPTZ
    deleted_by : UUID
  }

  entity "compras" as Tcompras {
    id : UUID <<PK>>
    processo_documental_id : UUID <<NN>>
    fornecedor_id : UUID <<NN>>
    unidade_id : UUID <<NN>>
    numero : TEXT <<NN>>
    data : DATE <<NN>>
    valor_total : NUMERIC
    situacao : TEXT <<NN>>
    pendencias_impeditivas : BOOLEAN <<NN>>
    created_at : TIMESTAMPTZ <<NN>>
    created_by : UUID
    updated_at : TIMESTAMPTZ <<NN>>
    updated_by : UUID
    deleted_at : TIMESTAMPTZ
    deleted_by : UUID
  }

  entity "contratos" as Tcontratos {
    id : UUID <<PK>>
    processo_documental_id : UUID <<NN>>
    fornecedor_id : UUID <<NN>>
    unidade_id : UUID <<NN>>
    licitacao_master_id : UUID
    compra_id : UUID
    numero : TEXT <<NN>>
    data_inicio : DATE <<NN>>
    data_fim : DATE
    valor : NUMERIC
    objeto : TEXT
    situacao : TEXT <<NN>>
    created_at : TIMESTAMPTZ <<NN>>
    created_by : UUID
    updated_at : TIMESTAMPTZ <<NN>>
    updated_by : UUID
    deleted_at : TIMESTAMPTZ
    deleted_by : UUID
  }

  entity "eventos" as Teventos {
    id : UUID <<PK>>
    ocorrido_em : TIMESTAMPTZ <<NN>>
    categoria : TEXT <<NN>>
    tipo_evento : TEXT <<NN>>
    ator_id : UUID
    ator_perfil : TEXT
    origem : TEXT <<NN>>
    operacao : TEXT <<NN>>
    recurso_tipo : TEXT <<NN>>
    recurso_id : UUID
    chave_negocio : TEXT
    resultado : TEXT <<NN>>
    correlation_id : UUID
    justificativa : TEXT
    detalhes : JSONB
    created_at : TIMESTAMPTZ <<NN>>
  }

}

