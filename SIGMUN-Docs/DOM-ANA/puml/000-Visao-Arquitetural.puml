@startuml
title DOM-ANA — Visão Arquitetural

legend
SIGMUN
DOM-ANA — Analytics e Inteligência
Visão Arquitetural — Arquitetura do domínio
Classificação da Informação: Pública
Responsável: Equipe SIGMUN
Status da revisão: Em elaboração
endlegend

skinparam componentStyle rectangle
skinparam packageStyle rectangle

package "Usuários e Canais" {
  actor "Servidor\npúblico" as User
  component "Portal Web\nSIGMUN" as Portal
}

package "DOM-ANA — Analytics e Inteligência" {
  component "API\n/api/v1/ana" as API
  component "Análise de Dados" as UC0
  component "Estatística" as UC1
  component "Modelos Preditivos" as UC2
  component "Ciência de Dados e IA" as UC3
  component "Apoio à Decisão" as UC4
}

package "Domínios Correlatos" {
  component "DOM-DAD\nDados Corporativos" as DDAD
  component "DOM-IND\nIndicadores e Desempenho" as DIND
  component "DOM-MET\nMetadados Corporativos" as DMET
}

package "Serviços Transversais" {
  component "DOM-IDN\nIdentidade e Acesso" as IDN
  component "DOM-GDO\nGestão Documental" as GDO
  component "Auditoria" as AUD
}

database "PostgreSQL\nschema ana" as DB

User --> Portal : executa rotina
Portal --> API : operações do domínio

API --> UC0 : previsto
API --> UC1 : previsto
API --> UC2 : previsto
API --> UC3 : previsto
API --> UC4 : previsto

API --> DDAD : troca de dados (prevista)
