Responsável: Equipe SIGMUN
Status da revisão: Vigente
endlegend

hide methods
hide stereotypes
skinparam linetype ortho
skinparam classAttributeIconSize 0

package "PostgreSQL — schema seg" {

  entity "controles_seguranca" as Tcontroles_seguranca {
    id : UUID <<PK>>
    codigo : TEXT <<UQ, NN>>
    nome : TEXT <<NN>>
    descricao : TEXT
    tipo : TEXT <<NN>>
    categoria : TEXT <<NN>>
    status : TEXT <<NN>>
    nivel_risco : TEXT <<NN>>
    responsavel_id : TEXT
    created_at : TIMESTAMPTZ <<NN>>
    updated_at : TIMESTAMPTZ <<NN>>
    is_deleted : BOOLEAN <<NN>>
  }

  entity "politicas_seguranca" as Tpoliticas_seguranca {
    id : UUID <<PK>>
    codigo : TEXT <<UQ, NN>>
    titulo : TEXT <<NN>>
    conteudo : TEXT <<NN>>
    versao : TEXT <<NN>>
    aprovador_id : TEXT
    data_aprovacao : TIMESTAMPTZ
    data_revisao : TIMESTAMPTZ
    ativa : BOOLEAN <<NN>>
    created_at : TIMESTAMPTZ <<NN>>
    updated_at : TIMESTAMPTZ <<NN>>
    is_deleted : BOOLEAN <<NN>>
  }

  entity "incidentes_seguranca" as Tincidentes_seguranca {
    id : UUID <<PK>>
    titulo : TEXT <<NN>>
    descricao : TEXT <<NN>>
    severidade : TEXT <<NN>>
    impacto : TEXT
    categoria : TEXT
    relator_id : TEXT
    atribuido_a : TEXT
    status : TEXT <<NN>>
    created_at : TIMESTAMPTZ <<NN>>
    updated_at : TIMESTAMPTZ <<NN>>
    data_resolucao : TIMESTAMPTZ
    is_deleted : BOOLEAN <<NN>>
  }

  entity "chaves_criptograficas" as Tchaves_criptograficas {
    id : UUID <<PK>>
    nome : TEXT <<NN>>
    algoritmo : TEXT <<NN>>
    tipo : TEXT <<NN>>
    tamanho_bits : INTEGER <<NN>>
    status : TEXT <<NN>>
    data_expiracao : TIMESTAMPTZ
    responsavel_id : TEXT
    created_at : TIMESTAMPTZ <<NN>>
    updated_at : TIMESTAMPTZ <<NN>>
    is_deleted : BOOLEAN <<NN>>
  }

  entity "credenciais" as Tcredenciais {
    id : UUID <<PK>>
    usuario_id : TEXT <<NN>>
    tipo : TEXT <<NN>>
    identificador : TEXT <<NN>>
    status : TEXT <<NN>>
    validade : TIMESTAMPTZ
    ultimo_uso : TIMESTAMPTZ
    tentativas_falhas : INTEGER <<NN>>
    created_at : TIMESTAMPTZ <<NN>>
    updated_at : TIMESTAMPTZ <<NN>>
    is_deleted : BOOLEAN <<NN>>
  }

}

