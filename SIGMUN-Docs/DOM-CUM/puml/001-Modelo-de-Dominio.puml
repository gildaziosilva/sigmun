}

package "Enumerações" {

enum TipoContato {
  TELEFONE = 'TEL'
  EMAIL = 'EMAIL'
  REDES = 'REDES'
  WHATSAPP = 'WHATSAPP'
}

enum TipoDocumento {
  CPF = 'CPF'
  CNPJ = 'CNPJ'
  RG = 'RG'
  INSCRICAO_ESTADUAL = 'INSCRICAO_ESTADUAL'
  INSCRICAO_MUNICIPAL = 'INSCRICAO_MUNICIPAL'
  CNH = 'CNH'
  OUTRO = 'OUTRO'
}

enum TipoEndereco {
  RESIDENCIAL = 'RESIDENCIAL'
  COMERCIAL = 'COMERCIAL'
  COBRANCA = 'COBRANCA'
  ENTREGA = 'ENTREGA'
  OUTRO = 'OUTRO'
}

enum TipoPessoa {
  FISICA = 'FISICA'
  JURIDICA = 'JURIDICA'
}

enum CategoriaPessoa {
  CIDADAO = 'CIDADAO'
  SERVIDOR = 'SERVIDOR'
  FORNECEDOR = 'FORNECEDOR'
  AGENTE_EXTERNO = 'AGENTE_EXTERNO'
}

enum Sexo {
  MASCULINO = 'M'
  FEMININO = 'F'
  OUTRO = 'OUTRO'
}

}

' =========================================================
' RELACIONAMENTOS
' =========================================================

Pessoa "1" *-- "0..*" Contato : "pessoa_id"
Pessoa "1" *-- "0..*" Documento : "pessoa_id"
Pessoa "1" *-- "0..*" Endereco : "pessoa_id"
UnidadeAdministrativa "1" *-- "0..*" Pessoa : "unidade_id"
Pessoa "1" *-- "0..*" PessoaFisica : "pessoa_id"
Pessoa "1" *-- "0..*" PessoaJuridica : "pessoa_id"
UnidadeAdministrativa "1" *-- "0..*" UnidadeAdministrativa : "unidade_pai_id"

Pessoa --> TipoPessoa
Pessoa --> CategoriaPessoa
Pessoa --> Sexo
Endereco --> TipoEndereco
Documento --> TipoDocumento
Contato --> TipoContato

note right of Pessoa
Regras de negócio (9):

- RN-CUM-001:
  a pessoa é física ou jurídica e sua extensão é obrigatória e única.
- RN-CUM-002:
  o CPF é validado por dígitos verificadores e armazenado sem máscara.
- RN-CUM-003:
  o CNPJ é validado por dígitos verificadores e armazenado sem máscara.
- RN-CUM-004:
  o número de documento é único entre pessoas não excluídas.
- RN-CUM-005:
  há no máximo um endereço principal por pessoa.
- RN-CUM-006:
  documento e contato principais são únicos no agregado da pessoa.
- e mais 3
end note

note bottom of Pessoa
Comportamentos (12):

- RegistrarPessoaUseCase
- ConsultarPessoaUseCase
- ListarPessoasUseCase
- AtualizarPessoaFisicaUseCase
- AtualizarPessoaJuridicaUseCase
- AlterarCategoriaPessoaUseCase
- ExcluirPessoaUseCase
- RegistrarUnidadeUseCase
- ConsultarUnidadeUseCase
- ListarUnidadesUseCase
- e mais 2
end note

@enduml
