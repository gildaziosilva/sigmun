  +created_by: string
  +updated_at: datetime
  +updated_by: string
  +deleted_at: datetime
  +deleted_by: string
}

class PessoaJuridica <<Entity>> {
  +id: string
  +pessoa_id: string
  +razao_social: string
  +nome_fantasia: string
