skinparam classAttributeIconSize 0

package "Entidades de DOM-CUM" {

class Contato <<Entity>> {
  +id: string
  +pessoa_id: string
  +tipo: string
  +valor: string
  +principal: bool
  +created_at: datetime
  +created_by: string
  +updated_at: datetime
  +updated_by: string
  +deleted_at: datetime
  +deleted_by: string
}

class Documento <<Entity>> {
  +id: string
  +pessoa_id: string
  +tipo: string
  +numero: string
  +orgao_emissor: string
  +data_emissao: date
  +data_validade: date
  +principal: bool
  +created_at: datetime
  +created_by: string
  +updated_at: datetime
  +updated_by: string
  +deleted_at: datetime
  +deleted_by: string
}

class Endereco <<Entity>> {
  +id: string
  +pessoa_id: string
  +tipo: string
  +logradouro: string
  +numero: string
  +complemento: string
  +bairro: string
  +cep: string
  +cidade: string
  +estado: string
  +pais: string
  +principal: bool
  +vigencia_inicio: datetime
  +vigencia_fim: datetime
  +motivo_alteracao: string
  +created_at: datetime
  +created_by: string
  +updated_at: datetime
  +updated_by: string
  +deleted_at: datetime
  +deleted_by: string
